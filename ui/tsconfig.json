{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": { "@protocol/*": ["../protocol/generated/*"] }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "probe/**/*.ts", "probe/**/*.vue", "tests/**/*.ts", "../protocol/generated/ui.ts", "vite.config.ts"]
}
